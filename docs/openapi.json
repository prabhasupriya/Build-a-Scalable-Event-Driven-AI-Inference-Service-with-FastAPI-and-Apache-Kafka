{
  "openapi": "3.1.0",
  "info": {
    "title": "Event-Driven AI Inference API",
    "description": "Accepts inference requests, publishes them to Apache Kafka and exposes the status/result of each request. Inference itself runs asynchronously in a separate consumer service.",
    "version": "1.0.0"
  },
  "paths": {
    "/inference": {
      "post": {
        "tags": [
          "inference"
        ],
        "summary": "Submit an inference request",
        "description": "Validate, persist as ``PENDING``, publish to Kafka and return ``202`` immediately.",
        "operationId": "submit_inference_request_inference_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InferenceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request body (client error)"
          },
          "503": {
            "description": "Database or Kafka unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/inference/{request_id}": {
      "get": {
        "tags": [
          "inference"
        ],
        "summary": "Get the status / result of an inference request",
        "operationId": "get_inference_result_inference__request_id__get",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "title": "Request Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InferenceResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unknown request_id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Liveness / readiness probe",
        "description": "Return 200 when the database and Kafka are reachable, otherwise 503.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InferenceRequest": {
        "properties": {
          "input_data": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Input Data",
            "description": "Text to analyse, or a URL pointing at the input (e.g. an image)."
          },
          "model_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/\\-]*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Id",
            "description": "Identifier of the model that should serve the request.",
            "default": "default_model"
          }
        },
        "type": "object",
        "required": [
          "input_data"
        ],
        "title": "InferenceRequest",
        "description": "Body of ``POST /inference``.",
        "example": {
          "input_data": "A photo of a cat on a sofa",
          "model_id": "resnet50"
        }
      },
      "InferenceResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "input_data": {
            "type": "string",
            "title": "Input Data"
          },
          "output_data": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Data"
          },
          "timestamp": {
            "type": "number",
            "title": "Timestamp"
          },
          "model_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Id"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "status",
          "input_data",
          "timestamp"
        ],
        "title": "InferenceResponse",
        "description": "Body returned by ``GET /inference/{request_id}``."
      },
      "SubmitResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "PENDING"
          },
          "timestamp": {
            "type": "number",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "timestamp"
        ],
        "title": "SubmitResponse",
        "description": "Body returned with ``202 Accepted`` by ``POST /inference``."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}