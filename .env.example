# ---------------------------------------------------------------
# Copy this file to `.env` before running `docker compose up`:
#   cp .env.example .env
# (every variable also has a default in docker-compose.yml, so the stack
#  starts even without a .env file)
# ---------------------------------------------------------------

# FastAPI Service
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_REQUESTS=inference_requests
KAFKA_TOPIC_DLQ=inference_requests_dlq
KAFKA_CONSUMER_GROUP_ID=inference_workers
# Partitions = max number of consumers that can work in parallel
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1

# PostgreSQL Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=inference_db

# Logging (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Kafka consumer
CONSUMER_HEALTH_PORT=8001
# Duration of the simulated model call
INFERENCE_SIMULATED_SECONDS=5
# Attempts per request before it is marked FAILED and dead-lettered
INFERENCE_MAX_ATTEMPTS=3
# Any input containing this text makes the simulated inference fail (for demos/tests)
INFERENCE_FAILURE_MARKER=__fail__
# A PROCESSING row older than this is treated as abandoned and re-claimed
PROCESSING_LEASE_SECONDS=120

# Retry / exponential backoff (used by both services for DB and Kafka calls)
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=10
